{
  "name": "frontend",
  "sourceRoot": "apps/frontend/src",
  "projectType": "application",
  "implicitDependencies": ["contracts"],
  "tags": ["scope:frontend", "type:app"],
  "targets": {
    "build": { "executor": "nx:run-commands", "options": { "command": "vite build --config apps/frontend/vite.config.ts" }, "outputs": ["{workspaceRoot}/dist/apps/frontend"] },
    "serve": { "executor": "nx:run-commands", "options": { "command": "vite --config apps/frontend/vite.config.ts --host 0.0.0.0" } },
    "typecheck": { "executor": "nx:run-commands", "options": { "command": "tsc -p apps/frontend/tsconfig.json --noEmit" } },
    "lint": { "executor": "nx:run-commands", "options": { "command": "eslint apps/frontend" } },
    "test": { "executor": "nx:run-commands", "options": { "command": "vitest run --config apps/frontend/vite.config.ts" } },
    "container": { "executor": "nx:run-commands", "options": { "command": "docker build -f apps/frontend/Dockerfile -t acme-frontend:local ." } }
  }
}
