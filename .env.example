# Local Keycloak bootstrap only. Choose a password before running docker compose.
KEYCLOAK_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
POSTGRES_RUNTIME_PASSWORD=
# Optional: start the telemetry stack with docker compose -f compose.observability.yaml up -d
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1
GRAFANA_ADMIN_PASSWORD=

# docker compose -f compose.async.yaml up -d --wait
ASYNC_ENABLED=true
POSTGRES_WORKER_PASSWORD=
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6390
QUEUE_REDIS_PASSWORD=
CACHE_REDIS_HOST=localhost
CACHE_REDIS_PORT=6391
CACHE_REDIS_PASSWORD=
KAFKA_BROKERS=localhost:9092
