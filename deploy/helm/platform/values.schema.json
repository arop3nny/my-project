{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "frontend",
    "backend",
    "gateway",
    "auth",
    "database"
  ],
  "properties": {
    "frontend": {
      "$ref": "#/definitions/component"
    },
    "backend": {
      "$ref": "#/definitions/component"
    },
    "gateway": {
      "type": "object",
      "required": [
        "name",
        "namespace",
        "hostname"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "definitions": {
    "component": {
      "type": "object",
      "required": [
        "image",
        "replicaCount",
        "port",
        "servicePort",
        "autoscaling"
      ],
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "servicePort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "image": {
          "type": "object",
          "required": [
            "repository"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "anyOf": [
            {
              "required": [
                "digest"
              ],
              "properties": {
                "digest": {
                  "minLength": 1
                }
              }
            },
            {
              "required": [
                "tag"
              ],
              "properties": {
                "tag": {
                  "minLength": 1
                }
              }
            }
          ]
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        }
      }
    }
  }
}
