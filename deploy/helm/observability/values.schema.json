{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "environment",
    "grafanaAdminSecret",
    "components",
    "collector",
    "logAgent"
  ],
  "properties": {
    "environment": {
      "enum": [
        "staging",
        "production"
      ]
    },
    "grafanaAdminSecret": {
      "type": "string",
      "minLength": 1
    },
    "logAgent": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "components": {
      "type": "object",
      "required": [
        "loki",
        "tempo",
        "prometheus",
        "grafana"
      ]
    }
  }
}
