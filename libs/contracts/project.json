{
  "name": "contracts",
  "sourceRoot": "libs/contracts/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:contracts"],
  "targets": {
    "build": { "executor": "nx:run-commands", "options": { "command": "tsc -p libs/contracts/tsconfig.json --declaration --emitDeclarationOnly --outDir dist/libs/contracts" }, "outputs": ["{workspaceRoot}/dist/libs/contracts"] },
    "typecheck": { "executor": "nx:run-commands", "options": { "command": "tsc -p libs/contracts/tsconfig.json --noEmit" } },
    "lint": { "executor": "nx:run-commands", "options": { "command": "eslint libs/contracts" } }
  }
}
