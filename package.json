{
  "name": "acme-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "nx run-many -t serve serve-worker -p frontend backend --parallel=3",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "check": "nx run-many -t lint typecheck test build",
    "graph": "nx graph",
    "test:release": "node --test tools/ci/*.test.mjs",
    "helm:check": "bash tools/helm/check.sh",
    "db:setup": "node --env-file-if-exists=.env tools/database/setup-local.mjs",
    "db:migrate": "nx run backend:migrate",
    "db:rollback": "nx run backend:rollback",
    "db:status": "nx run backend:migration-status",
    "db:generate": "node --env-file-if-exists=.env --import tsx node_modules/typeorm/cli.js migration:generate -d apps/backend/typeorm.config.ts",
    "db:create": "node node_modules/typeorm/cli.js migration:create",
    "dev:worker": "nx run backend:serve-worker",
    "kafka:setup": "node --env-file-if-exists=.env tools/database/setup-kafka.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "^0.27.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "nx": "23.2.0",
    "shadcn": "4.21.0",
    "supertest": "^7.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "tw-animate-css": "1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "yaml": "2.9.0",
    "pg": "8.23.0",
    "kafkajs": "2.2.4",
    "typeorm": "1.1.1",
    "jose": "6.2.11"
  },
  "packageManager": "pnpm@11.25.0"
}
